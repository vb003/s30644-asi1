{
  "name": "ASI onboarding",

  "image": "mcr.microsoft.com/devcontainers/miniconda:3",

  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  "postCreateCommand": "bash scripts/setup_devcontainer.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ]
    }
  },

  "remoteUser": "vscode"
}
